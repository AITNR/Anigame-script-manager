<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Yomori.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 主页 = 一张图（2026-10-23 起）。原来的「总览」状态卡、三张入口卡与会话通道列表
         全部移除：状态在右侧执行状态栏、通道在左侧导航，主页不必重复一遍。
         图片路径存在 config.json 的 home_banner，右键更换。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 上次运行异常报告 -->
        <InfoBar x:Name="ProblemReportBar"
                 Grid.Row="0"
                 Margin="16,12,16,0"
                 IsOpen="False"
                 Severity="Warning"
                 Title="上次运行存在需要注意的情况"
                 IsClosable="True"
                 CloseButtonClick="OnProblemReportClosed">
            <InfoBar.Content>
                <TextBlock x:Name="ProblemReportText" TextWrapping="Wrap" />
            </InfoBar.Content>
            <InfoBar.ActionButton>
                <Button Content="打开日志目录" Click="OnOpenLogFolder" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- 大图区：整块都能右键 -->
        <Grid x:Name="BannerHost"
              Grid.Row="1"
              MinHeight="200"
              Background="{ThemeResource LayerFillColorDefaultBrush}">

            <Image x:Name="BannerImage"
                   Stretch="UniformToFill"
                   Visibility="Collapsed" />

            <!-- 没设置图片（或图片已经找不到了）时的占位 -->
            <StackPanel x:Name="BannerPlaceholder"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="460"
                        Spacing="8">
                <TextBlock x:Name="PlaceholderTitle"
                           Text="还没有设置首页图片"
                           HorizontalAlignment="Center"
                           Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="PlaceholderHint"
                           Text="在任意位置点右键，选一张图片放到这里。"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Opacity="0.7"
                           FontSize="12" />
            </StackPanel>

            <!-- 有图时的小提示：不然「右键能换图」这件事没人猜得到 -->
            <Border x:Name="BannerHint"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,14,14"
                    Padding="9,4"
                    CornerRadius="4"
                    Background="#66000000"
                    Visibility="Collapsed">
                <TextBlock Text="右键更换图片" FontSize="11" Foreground="White" />
            </Border>

            <Grid.ContextFlyout>
                <MenuFlyout Opening="OnBannerMenuOpening">
                    <MenuFlyoutItem Text="更换图片…" Click="OnChangeBannerImage" />
                    <MenuFlyoutItem x:Name="ClearBannerItem" Text="恢复默认图片" Click="OnRestoreDefaultBanner" />
                </MenuFlyout>
            </Grid.ContextFlyout>
        </Grid>
    </Grid>
</Page>
