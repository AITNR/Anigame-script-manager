<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YukinoChan.Views.StatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:YukinoChan.ViewModels">

    <Grid Padding="16,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="运行耗时统计" Style="{StaticResource SubtitleTextBlockStyle}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="刷新统计" Click="OnRefresh" />
            <Button Content="打开统计目录" Click="OnOpenFolder" />
        </StackPanel>

        <Border Grid.Row="2"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <ListView ItemsSource="{x:Bind VM.StatRows, Mode=OneWay}"
                      SelectionMode="None">
                <ListView.Header>
                    <Grid Padding="14,10" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="2.4*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="脚本名称" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="次数" FontWeight="SemiBold" TextAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="平均耗时" FontWeight="SemiBold" TextAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="最近耗时" FontWeight="SemiBold" TextAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="最近完成时间" FontWeight="SemiBold" />
                    </Grid>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:StatRow">
                        <Grid Padding="14,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="2.4*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Count}" TextAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{x:Bind AverageText}" TextAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{x:Bind LastText}" TextAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{x:Bind LastTime}" Opacity="0.75" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
