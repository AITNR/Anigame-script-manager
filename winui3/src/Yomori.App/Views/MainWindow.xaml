<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Yomori.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Yomori"
    xmlns:vm="using:Yomori.ViewModels"
    xmlns:views="using:Yomori.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 自定义标题栏 ===== -->
        <Grid x:Name="AppTitleBar" Height="44" Canvas.ZIndex="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 标题栏左侧徽标：直接用应用 logo。
                 位图在代码里加载（AssetsDir/logo.png）—— unpackaged 运行时 XAML 里的
                 ms-appx 相对路径取不到 exe 同级目录，必须走绝对路径。 -->
            <Image
                x:Name="TitleBarLogo"
                Grid.Column="0"
                Width="22" Height="22" Margin="14,0,10,0"
                Stretch="Uniform"
                AutomationProperties.Name="Yomori" />

            <TextBlock Grid.Column="1"
                       Text="Yomori / 二游脚本助手"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       VerticalAlignment="Center"
                       Opacity="0.85" />
        </Grid>

        <!-- ===== 主体：NavigationView 外壳 ===== -->
        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        OpenPaneLength="196"
                        SelectionChanged="OnNavigationSelectionChanged"
                        ItemInvoked="OnNavigationItemInvoked">

            <NavigationView.MenuItems>
                <NavigationViewItem Tag="home" Content="总览" Icon="Home" />
                <NavigationViewItem Tag="tasks" Content="任务执行" Icon="List" />
                <NavigationViewItem Tag="stats" Content="耗时统计" Icon="Clock" />
                <NavigationViewItem Tag="logs" Content="运行日志" Icon="Document" />

                <!-- 「会话通道」= 父项：点它本身只展开/收起子菜单，不导航（多画面入口在子项）；
                     它下面的子菜单才是各条通道单独的画面 + 通道管理。
                     子项由 MainWindow.RebuildChannelMenuItems() 按已配置/在跑的通道重建，
                     这里留一个「通道管理…」兜底，保证它一上来就是「带子项的父项」形态。 -->
                <NavigationViewItem x:Name="ChannelsNavItem"
                                    Tag="channels"
                                    Content="会话通道"
                                    Icon="People"
                                    IsExpanded="True">
                    <!-- 子项必须放进 MenuItems 属性元素：直接写成子元素会被当成 Content（WMC0035） -->
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem Tag="channel-mgmt" Content="通道管理…" Icon="Setting" />
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Tag="settings" Content="设置" Icon="Setting" />
            </NavigationView.FooterMenuItems>

            <NavigationView.Content>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 运行控制栏 -->
                    <Border Grid.Row="0" Grid.Column="0"
                            Padding="12,8"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="开始执行"
                                    Style="{StaticResource AccentButtonStyle}"
                                    IsEnabled="{x:Bind VM.CanStart, Mode=OneWay}"
                                    Click="OnStartClicked" />
                            <Button Content="暂停执行"
                                    IsEnabled="{x:Bind VM.CanPause, Mode=OneWay}"
                                    Click="OnPauseClicked" />
                            <Button Content="继续执行"
                                    IsEnabled="{x:Bind VM.IsRunning, Mode=OneWay}"
                                    Click="OnResumeClicked" />
                            <Button Content="停止执行  F8"
                                    IsEnabled="{x:Bind VM.CanStop, Mode=OneWay}"
                                    Click="OnStopClicked"
                                    Background="{StaticResource YomoriDangerBrush}" />
                            <Button Content="紧急停止全部  Ctrl+Alt+F8"
                                    IsEnabled="{x:Bind VM.CanStop, Mode=OneWay}"
                                    Click="OnEmergencyStopClicked"
                                    Background="{StaticResource YomoriDangerDeepBrush}" />
                            <Button Content="保存配置" Click="OnSaveClicked" />
                            <Button Content="取消关机" Click="OnCancelShutdownClicked" />
                        </StackPanel>
                    </Border>

                    <!-- 页面容器 -->
                    <Frame x:Name="ContentFrame"
                           Grid.Row="1" Grid.Column="0" />
                </Grid>
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Window>
