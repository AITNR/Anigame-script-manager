<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Yomori主题色：沿用经典风的雾蓝色系，适配 Fluent / WinUI 3 -->
    <Color x:Key="YomoriAccent">#FF6C8EBF</Color>
    <Color x:Key="YomoriAccentSoft">#FFB7C7E6</Color>
    <Color x:Key="YomoriSurface">#FFF4F8FD</Color>
    <Color x:Key="YomoriBorder">#FFD6E0EE</Color>
    <Color x:Key="YomoriDanger">#FFB3261E</Color>
    <Color x:Key="YomoriDangerDeep">#FF8B0000</Color>

    <SolidColorBrush x:Key="YomoriAccentBrush" Color="{StaticResource YomoriAccent}" />
    <SolidColorBrush x:Key="YomoriAccentSoftBrush" Color="{StaticResource YomoriAccentSoft}" />
    <SolidColorBrush x:Key="YomoriSurfaceBrush" Color="{StaticResource YomoriSurface}" />
    <SolidColorBrush x:Key="YomoriBorderBrush" Color="{StaticResource YomoriBorder}" />
    <SolidColorBrush x:Key="YomoriDangerBrush" Color="{StaticResource YomoriDanger}" />
    <SolidColorBrush x:Key="YomoriDangerDeepBrush" Color="{StaticResource YomoriDangerDeep}" />

    <!-- 停止 / 紧急停止：高对比危险操作按钮 -->
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- 卡片：Fluent 圆角 + 轻量投影 -->
    <Style x:Key="YomoriCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- 状态条标签 / 数值 -->
    <Style x:Key="StatusLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StatusValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 总览页大卡片 -->
    <Style x:Key="OverviewCardStyle" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    </Style>

    <!-- 表格行：鼠标悬停反馈 -->
    <Style x:Key="TaskRowStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinHeight" Value="44" />
    </Style>

</ResourceDictionary>
