<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YukinoChan.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:YukinoChan.ViewModels">

    <ScrollViewer Padding="20,16">
        <StackPanel Spacing="16">

            <!-- 上次运行异常报告 -->
            <InfoBar x:Name="ProblemReportBar"
                     IsOpen="False"
                     Severity="Warning"
                     Title="上次运行存在需要注意的情况"
                     IsClosable="True"
                     CloseButtonClick="OnProblemReportClosed">
                <InfoBar.Content>
                    <TextBlock x:Name="ProblemReportText" TextWrapping="Wrap" />
                </InfoBar.Content>
                <InfoBar.ActionButton>
                    <Button Content="打开日志目录" Click="OnOpenLogFolder" />
                </InfoBar.ActionButton>
            </InfoBar>

            <TextBlock Text="总览" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="选择一张卡片开始操作；雪乃酱会在右侧全程陪着你。"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Opacity="0.7" />

            <!-- 快捷状态 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource YukinoCardStyle}" Margin="0,0,8,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="状态" Style="{StaticResource StatusLabelStyle}" />
                        <TextBlock Text="{x:Bind VM.StatusText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource YukinoCardStyle}" Margin="4,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="当前任务" Style="{StaticResource StatusLabelStyle}" />
                        <TextBlock Text="{x:Bind VM.CurrentTaskName, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource YukinoCardStyle}" Margin="4,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="任务数" Style="{StaticResource StatusLabelStyle}" />
                        <TextBlock Text="{x:Bind VM.Tasks.Count, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource YukinoCardStyle}" Margin="8,0,0,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="进度" Style="{StaticResource StatusLabelStyle}" />
                        <TextBlock Text="{x:Bind VM.ProgressText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 三张主卡片（对应 Python 版的卡片式总览） -->
            <Grid MinHeight="260">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Margin="0,0,8,0"
                        Style="{StaticResource OverviewCardStyle}"
                        Click="OnOpenTasks">
                    <Grid Padding="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource YukinoAccentBrush}">
                            <FontIcon Glyph="&#xE8FD;" Foreground="White" FontSize="20" />
                        </Border>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="6" Margin="0,14,0,0">
                            <TextBlock Text="任务执行" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="配置脚本路径、超时策略、并发组与监控关键词。"
                                       TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="进入 →" FontSize="12" Opacity="0.6" />
                    </Grid>
                </Button>

                <Button Grid.Column="1" Margin="4,0"
                        Style="{StaticResource OverviewCardStyle}"
                        Click="OnOpenStats">
                    <Grid Padding="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource YukinoAccentSoftBrush}">
                            <FontIcon Glyph="&#xE916;" Foreground="White" FontSize="20" />
                        </Border>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="6" Margin="0,14,0,0">
                            <TextBlock Text="运行耗时统计" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="按脚本查看执行次数、平均耗时与最近完成时间。"
                                       TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="进入 →" FontSize="12" Opacity="0.6" />
                    </Grid>
                </Button>

                <Button Grid.Column="2" Margin="8,0,0,0"
                        Style="{StaticResource OverviewCardStyle}"
                        Click="OnOpenLogs">
                    <Grid Padding="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource YukinoAccentSoftBrush}">
                            <FontIcon Glyph="&#xE8A5;" Foreground="White" FontSize="20" />
                        </Border>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="6" Margin="0,14,0,0">
                            <TextBlock Text="运行日志" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="实时查看调度过程，出问题时在这里找原因。"
                                       TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="进入 →" FontSize="12" Opacity="0.6" />
                    </Grid>
                </Button>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
