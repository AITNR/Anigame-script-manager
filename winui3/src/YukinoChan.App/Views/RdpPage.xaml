<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YukinoChan.Views.RdpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:YukinoChan.Models"
    xmlns:views="using:YukinoChan.Views">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="16,12" Spacing="12">

            <!-- 标题与总开关 -->
            <StackPanel Spacing="4">
                <TextBlock Text="远程会话执行" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="通过远程桌面登录另一个 Windows 账户会话，让任务在目标账户里自动跑完。默认连本机（127.0.0.1）切换本机账户，也可以填局域网或公网地址连另一台机器。"
                           Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>

            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Padding="14">
                <StackPanel Spacing="10">
                    <ToggleSwitch Header="在目标账户会话中执行任务"
                                  OnContent="已启用（点「开始执行」时会先连接目标账户）"
                                  OffContent="关闭（仍在当前账户本地执行）"
                                  IsOn="{x:Bind VM.RdpSettings.Enabled, Mode=TwoWay}" />

                    <TextBlock Text="Windows 客户端版同时只允许一个交互式会话：连接成功后，你当前这个桌面会被锁定，任务在目标账户里跑。主控端会持续读取目标会话回传的状态，并在这里弹通知。"
                               Opacity="0.65"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 目标主机与账户 -->
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Padding="14">
                <StackPanel Spacing="10">
                    <TextBlock Text="连接目标" FontWeight="SemiBold" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 x:Name="HostInput"
                                 Header="远程主机"
                                 PlaceholderText="127.0.0.1（可填 IP、主机名，或带端口如 192.168.1.20:3390）"
                                 Text="{x:Bind VM.RdpSettings.TargetHost, Mode=TwoWay}"
                                 TextChanged="OnHostTextChanged" />

                        <Button Grid.Column="1"
                                Content="用本机"
                                VerticalAlignment="Bottom"
                                Click="OnUseLocalHost"
                                ToolTipService.ToolTip="填回 127.0.0.1，切本机另一个账户" />
                    </Grid>

                    <TextBlock x:Name="HostHint"
                               Opacity="0.65"
                               FontSize="12"
                               TextWrapping="Wrap" />

                    <TextBox Header="指令桥目录（仅远程主机需要）"
                             PlaceholderText="留空＝本机 ProgramData；远程填 \\\\192.168.1.20\\YukinoBridge"
                             Text="{x:Bind VM.RdpSettings.BridgePath, Mode=TwoWay}" />

                    <TextBlock Text="目标是本机另一个账户时，指令就走本机共享目录，这一栏留空即可。目标是别的机器时，对方读不到本机文件，必须指定一个双方都能读写的共享位置。"
                               Opacity="0.65"
                               FontSize="12"
                               TextWrapping="Wrap" />

                    <TextBox Header="账户名"
                             PlaceholderText="例如 Player2 或 机器名\\Player2"
                             Text="{x:Bind VM.RdpSettings.TargetUser, Mode=TwoWay}" />

                    <PasswordBox x:Name="PasswordInput"
                                 Header="登录密码"
                                 PlaceholderText="仅用于存入 Windows 凭据管理器"
                                 PasswordChar="●" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="保存凭据" Click="OnSaveCredential" />
                        <Button Content="清除已保存凭据" Click="OnClearCredential" />
                    </StackPanel>

                    <TextBlock Text="密码只通过 Windows 凭据管理器保存，不会写进 config.json。目标账户必须设置过登录密码，空密码账户无法通过远程桌面登录。"
                               Opacity="0.65"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 环境预检 -->
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Padding="14">
                <StackPanel Spacing="10">
                    <TextBlock Text="环境预检" FontWeight="SemiBold" />

                    <InfoBar x:Name="ReadinessBar"
                             IsOpen="True"
                             IsClosable="False"
                             Severity="Informational"
                             Title="检查结果"
                             Message="{x:Bind VM.RdpReadinessText, Mode=OneWay}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="目标会话：" Opacity="0.7" />
                        <TextBlock Grid.Column="1" Text="{x:Bind VM.RdpSessionSummary, Mode=OneWay}" TextWrapping="Wrap" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="代理状态：" Opacity="0.7" />
                        <TextBlock Grid.Column="1" Text="{x:Bind VM.RdpAgentStatusText, Mode=OneWay}" TextWrapping="Wrap" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="开启远程桌面" Click="OnEnableRemoteDesktop"
                                ToolTipService.ToolTip="需要管理员权限：写入注册表并放行防火墙" />
                        <Button Content="部署会话代理" Click="OnDeployAgent"
                                ToolTipService.ToolTip="把代理放进所有用户共享的启动目录，目标账户登录后自动接管任务" />
                        <Button Content="移除代理" Click="OnRemoveAgent" />
                        <Button Content="重新检查" Click="OnRefreshReadiness" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="共享目录：" Opacity="0.7" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind VM.RdpBridgePath, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Opacity="0.8" />
                        <Button Grid.Column="2" Content="打开" Click="OnOpenBridgeFolder" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 远程桌面连接 -->
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Padding="14">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="远程桌面连接" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   x:Name="ResolutionHint"
                                   Opacity="0.6"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="使用 Windows 自带的远程桌面打开独立窗口连接目标账户，登录后会话代理会自动接管任务。"
                               Opacity="0.7"
                               TextWrapping="Wrap" />

                    <ComboBox x:Name="ResolutionBox"
                              Header="远程桌面窗口尺寸"
                              ItemsSource="{x:Bind VM.ResolutionItems}"
                              DisplayMemberPath="Value"
                              SelectedValuePath="Key"
                              SelectedValue="{x:Bind VM.RdpResolutionKey, Mode=TwoWay}"
                              SelectionChanged="OnResolutionChanged"
                              HorizontalAlignment="Stretch" />

                    <TextBlock Text="选「自动」时由远程桌面客户端自己决定窗口尺寸（通常是全屏）；选具体档位会按这个分辨率开一个固定尺寸的窗口，窗口被缩小时整体等比显示、不出现滚动条。改档位后需要重新连接才生效。"
                               Opacity="0.65"
                               FontSize="12"
                               TextWrapping="Wrap" />

                    <ComboBox x:Name="ClientModeBox"
                              Header="连接方式"
                              ItemsSource="{x:Bind VM.ClientModeItems}"
                              DisplayMemberPath="Value"
                              SelectedValuePath="Key"
                              SelectedValue="{x:Bind VM.RdpSettings.ClientMode, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" />

                    <CheckBox x:Name="EmbedAudioSettingCheck"
                              Content="内嵌模式下在本机播放远端声音"
                              IsChecked="{x:Bind VM.RdpSettings.AudioEnabled, Mode=TwoWay}" />

                    <CheckBox x:Name="EmbedGfxSettingCheck"
                              Content="GFX 全帧管线（实验性：撕裂根治，需重连生效）"
                              IsChecked="{x:Bind VM.RdpSettings.GfxEnabled, Mode=TwoWay}"
                              ToolTipService.ToolTip="走 RDP 图形管道协商 progressive 全帧，远端快速变化时不再撕裂；默认关闭" />

                    <TextBlock Text="选「内嵌」时画面直接显示在本页下方的「内嵌画面」卡片里，鼠标键盘可直接操作；选「独立窗口」时用系统 mstsc 开窗口（稳定，永久可用）。改连接方式后下次连接生效。"
                               Opacity="0.65"
                               FontSize="12"
                               TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="连接目标账户" Click="OnConnectSurface"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="按上方连接方式连接目标账户，不下发任务" />
                        <Button Content="断开目标会话" Click="OnDisconnectSurface"
                                ToolTipService.ToolTip="断开目标账户的连接（内嵌=断开画面保留会话；会话收尾方式仍遵循上面的设置）" />
                    </StackPanel>

                    <TextBlock x:Name="EmbedModeHint"
                               Text="连接后本机当前桌面会被锁定，任务在目标账户里执行。任务进度会持续回传到这里，每个任务完成都会发系统通知。"
                               Opacity="0.65"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 执行与通知设置 -->
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Padding="14">
                <StackPanel Spacing="10">
                    <TextBlock Text="执行与通知" FontWeight="SemiBold" />

                    <ComboBox Header="任务全部结束后的会话处理"
                              ItemsSource="{x:Bind VM.SessionFinishItems}"
                              DisplayMemberPath="Value"
                              SelectedValuePath="Key"
                              SelectedValue="{x:Bind VM.RdpSettings.SessionFinish, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" />

                    <NumberBox Header="等待目标会话建立的超时（秒）"
                               Minimum="15"
                               Maximum="600"
                               SpinButtonPlacementMode="Compact"
                               Value="{x:Bind VM.RdpSettings.ConnectTimeoutSeconds, Mode=TwoWay}" />

                    <ToggleSwitch Header="每完成一个任务都发系统通知"
                                  IsOn="{x:Bind VM.RdpSettings.NotifyOnTaskDone, Mode=TwoWay}" />
                    <ToggleSwitch Header="全部任务完成后发汇总通知"
                                  IsOn="{x:Bind VM.RdpSettings.NotifyOnAllDone, Mode=TwoWay}" />
                    <ToggleSwitch Header="本地（非远程会话）执行时也发通知"
                                  IsOn="{x:Bind VM.RdpSettings.NotifyLocalTaskDone, Mode=TwoWay}" />

                    <TextBlock Text="系统通知只在发出它的那个用户会话里显示，所以远程任务完成时，目标会话和主控端会各发一次，你在哪边都看得到。"
                               Opacity="0.65"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 连接与进度 -->
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Padding="14">
                <StackPanel Spacing="10">
                    <TextBlock Text="连接与进度" FontWeight="SemiBold" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="连接并执行"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind VM.ConnectAndRunCommand}" />
                        <Button Content="断开目标会话" Command="{x:Bind VM.DisconnectSessionCommand}" />
                        <Button Content="注销目标账户" Command="{x:Bind VM.LogoffSessionCommand}" />
                    </StackPanel>

                    <!-- 代理失联告警：会话断开/注销后代理会被连带终止，必须显式提示，
                         否则界面永远停在「运行中」，分不清是卡住还是已经死了 -->
                    <InfoBar IsOpen="{x:Bind VM.RdpIsStale, Mode=OneWay}"
                             IsClosable="False"
                             Severity="Error"
                             Title="会话代理已失联"
                             Message="已经超过 20 秒没收到心跳，目标会话可能已断开或被注销 —— 会话里的代理与脚本进程会随之终止。若你是主动断开远程桌面，请用「断开连接」而不是「注销目标账户」，任务才能继续在后台跑。" />

                    <ProgressBar Minimum="0"
                                 Maximum="{x:Bind VM.RdpTotal, Mode=OneWay}"
                                 Value="{x:Bind VM.RdpProgress, Mode=OneWay}"
                                 ShowPaused="{x:Bind VM.IsRdpBusy, Mode=OneWay}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="状态：" Opacity="0.7" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind VM.RdpStatusText, Mode=OneWay}" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="当前任务：" Opacity="0.7" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind VM.RdpCurrentTask, Mode=OneWay}" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="进度：" Opacity="0.7" />
                        <TextBlock Grid.Row="2" Grid.Column="1">
                            <Run Text="{x:Bind VM.RdpProgress, Mode=OneWay}" />
                            <Run Text=" / " />
                            <Run Text="{x:Bind VM.RdpTotal, Mode=OneWay}" />
                        </TextBlock>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="当前任务已运行：" Opacity="0.7" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind VM.RdpElapsedText, Mode=OneWay}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="最后心跳：" Opacity="0.7" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind VM.RdpHeartbeatText, Mode=OneWay}" />
                    </Grid>

                    <TextBlock Text="远程事件" FontWeight="SemiBold" />

                    <Border Height="180"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <ListView ItemsSource="{x:Bind VM.RdpEvents, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:RdpTaskEvent">
                                    <Grid Padding="10,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Time}" Opacity="0.6" FontSize="12" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind IsAbnormal}"
                                                   FontSize="12"
                                                   Opacity="0.7"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Headline}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </StackPanel>
            </Border>

            <!-- M2 调试入口：内嵌画面预览（FreeRDP 路线；M5 会替换为 client_mode 正式接线） -->
            <Border x:Name="EmbedCard"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Padding="14">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="EmbedCardTitle" Text="内嵌画面（实验性）" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="连接方式选「内嵌」时，任务与「连接目标账户」的画面都会显示在这里；也可用下方按钮独立预览。"
                                   Opacity="0.6" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="EmbedConnectButton" Content="连接预览" Click="OnEmbedConnect" Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="EmbedDisconnectButton" Content="断开" Click="OnEmbedDisconnect" IsEnabled="False" />
                        <Button x:Name="EmbedFullScreenButton" Content="全屏" Click="OnEmbedFullScreenToggle" IsEnabled="False" />
                        <CheckBox x:Name="EmbedAudioCheck" Content="播放远端声音" IsChecked="True" VerticalAlignment="Center" />
                        <TextBlock x:Name="EmbedStatusText" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
                    </StackPanel>
                    <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                               Text="输入提示：点击画面获得焦点后，鼠标与键盘直接作用于远端。全屏时 Win 键、Alt+Tab 等系统组合键全部转投远端（F11 退出全屏）；Ctrl+Alt+Del 是系统安全序列任何客户端都无法转发，远端任务管理器请用 Ctrl+Shift+Esc。" />
                    <Border x:Name="EmbedHostBorder" Height="360">
                        <views:RdpView x:Name="EmbedView" />
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
