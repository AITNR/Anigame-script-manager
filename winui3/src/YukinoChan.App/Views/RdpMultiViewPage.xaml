<?xml version="1.0" encoding="utf-8"?>
<!-- 多画面页（计划书 docs/channel-menu-multiview-plan.md §4.2）：
     左侧菜单点「会话通道」父项（或它的「多画面（全部通道）」子项）就到这里 ——
     一眼看到**全部通道**的画面，这才是"多窗口"该在的位置。

     网格 2×2、每页最多 4 格（同时渲染 4 路是有意的上限），超过分页；
     每格可「弹出窗口」到自己摆放的独立窗口；本页**不提供全屏** ——
     全屏会盖掉别的路，要看一路放大请进该通道自己的页面（子菜单里那一条）。 -->
<Page
    x:Class="YukinoChan.Views.RdpMultiViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:YukinoChan.Views">

    <Grid Padding="16,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="260" />
        </Grid.RowDefinitions>

        <!-- ===== 头部：说明与批量操作 ===== -->
        <Border Grid.Row="0" Padding="14,10" Style="{StaticResource YukinoCardStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="多画面" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="MultiViewHintText"
                               Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                               Text="这里并列显示全部通道的画面；想单独看某一路，点左侧菜单里它自己的那一项。" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <Button Content="连接全部通道" Click="OnConnectAllClicked"
                            ToolTipService.ToolTip="给还没画面的通道各建一条内嵌连接（只看画面，不下发任务）" />
                    <Button Content="通道管理…" Click="OnOpenChannelManagerClicked" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 画面区：2×2 网格 ===== -->
        <Border Grid.Row="1" Padding="0" Style="{StaticResource YukinoCardStyle}">
            <Grid>
                <Grid x:Name="SurfaceLayout" Padding="6" RowSpacing="6" ColumnSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <views:RdpSurfaceCell x:Name="Cell0" Grid.Row="0" Grid.Column="0" />
                    <views:RdpSurfaceCell x:Name="Cell1" Grid.Row="0" Grid.Column="1" />
                    <views:RdpSurfaceCell x:Name="Cell2" Grid.Row="1" Grid.Column="0" />
                    <views:RdpSurfaceCell x:Name="Cell3" Grid.Row="1" Grid.Column="1" />
                </Grid>

                <!-- 一路通道都没有时的空态 -->
                <StackPanel x:Name="SurfaceEmptyHint"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="10" MaxWidth="460"
                            Visibility="Collapsed">
                    <TextBlock x:Name="SurfaceEmptyText"
                               TextWrapping="Wrap" TextAlignment="Center" Opacity="0.75" />
                    <Button x:Name="SurfaceEmptyActionButton"
                            Content="去通道管理新建通道"
                            HorizontalAlignment="Center"
                            Click="OnOpenChannelManagerClicked" />
                </StackPanel>

                <!-- 分页条（只有超过 4 条通道时才出现） -->
                <StackPanel x:Name="PagerBar"
                            Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Margin="0,0,0,10"
                            Visibility="Collapsed">
                    <Button x:Name="PrevPageButton" Content="上一页" Click="OnPrevPageClicked" />
                    <TextBlock x:Name="PageText" VerticalAlignment="Center" Opacity="0.8" />
                    <Button x:Name="NextPageButton" Content="下一页" Click="OnNextPageClicked" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
