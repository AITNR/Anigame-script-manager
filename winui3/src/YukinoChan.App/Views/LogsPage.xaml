<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YukinoChan.Views.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="16,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="运行日志" Style="{StaticResource SubtitleTextBlockStyle}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="清空显示" Click="OnClear" />
            <Button Content="打开日志目录" Click="OnOpenFolder" />
            <TextBlock VerticalAlignment="Center" Opacity="0.6" FontSize="12">
                <Run Text="共 " /><Run Text="{x:Bind VM.LogLines.Count, Mode=OneWay}" /><Run Text=" 行" />
            </TextBlock>
        </StackPanel>

        <Border Grid.Row="2"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <ListView x:Name="LogList"
                      ItemsSource="{x:Bind VM.LogLines, Mode=OneWay}"
                      SelectionMode="Single"
                      Padding="4"
                      ContainerContentChanging="OnLogItemRendering">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   FontFamily="Cascadia Mono, Consolas, monospace"
                                   FontSize="12"
                                   TextWrapping="NoWrap"
                                   Padding="6,2" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
