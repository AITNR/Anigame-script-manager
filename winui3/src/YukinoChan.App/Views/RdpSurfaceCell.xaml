<?xml version="1.0" encoding="utf-8"?>
<!-- 一格画面（M6 多画面同屏）：
     每格 = 一块 RdpView + 顶部「通道名 / 状态 / 操作」条 + 无画面时的占位。
     通道页按「单画面 / 多画面」摆 1 格或最多 2×2 格，每格各挂**自己那条通道**的内嵌连接
     （连接按通道分家见 MainViewModel 的 _embeds 字典）。 -->
<UserControl
    x:Class="YukinoChan.Views.RdpSurfaceCell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:YukinoChan.Views">

    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <views:RdpView x:Name="SurfaceView"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch" />

            <!-- 顶部信息条：通道名 + 状态 + 操作 -->
            <Grid x:Name="TopBar"
                  VerticalAlignment="Top"
                  Padding="8,6"
                  Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               Text="通道"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="StateText"
                               Text="未连接"
                               Opacity="0.7"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button x:Name="FullScreenButton" Content="全屏" Click="OnFullScreenClicked" />
                    <Button x:Name="PopOutButton" Content="弹出窗口" Click="OnPopOutClicked" />
                    <Button x:Name="DisconnectButton" Content="断开" Click="OnDisconnectClicked" />
                </StackPanel>
            </Grid>

            <!-- 无画面时的占位（按钮点一下就连） -->
            <StackPanel x:Name="Placeholder"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10"
                        MaxWidth="420">
                <TextBlock x:Name="PlaceholderText"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Opacity="0.75" />
                <Button x:Name="ConnectButton"
                        Content="连接到这条通道"
                        HorizontalAlignment="Center"
                        Click="OnConnectClicked" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
