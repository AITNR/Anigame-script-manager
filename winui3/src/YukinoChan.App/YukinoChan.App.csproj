<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>YukinoChan</RootNamespace>
    <AssemblyName>YukinoChan</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- 非打包（unpackaged）模式：可以直接 dotnet build / 直接双击 exe 运行，不依赖 MSIX 工具链 -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1416;CS1591;NU1701</NoWarn>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- 用自己的 Main（Program.cs）：XAML 初始化失败时也能先落日志 -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <!-- 仅用于超时现场截图（全屏抓图） -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <!-- .NET 8 默认不含 GBK(936) 等代码页编码，读 netsh / cmdkey 等原生工具的 GBK 输出要靠它提供的 CodePagesEncodingProvider -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- RdpNative：ycn_rdp.dll + FreeRDP 运行时（仅 x64；构建前置 = 先 build YukinoChan.RdpNative） -->
  <ItemGroup Condition="'$(Platform)'=='x64'">
    <None Include="..\YukinoChan.RdpNative\build\Release\ycn_rdp.dll" Link="ycn_rdp.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <Target Name="CopyRdpRuntimeDlls" AfterTargets="Build" Condition="'$(Platform)'=='x64'">
    <ItemGroup>
      <RdpRuntimeDll Include="..\YukinoChan.RdpNative\build\Release\*.dll" Exclude="..\YukinoChan.RdpNative\build\Release\ycn_rdp.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(RdpRuntimeDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
